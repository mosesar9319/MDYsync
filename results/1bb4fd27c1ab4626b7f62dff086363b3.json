  "segments": [
    {
      "ref": "Chullin 86a:1",
      "start": 448.0,
      "end": 480.0,
      "he": "לָא מִיבַּעְיָא קָאָמַר: לָא מִיבַּעְיָא ״צֵא נְחוֹר״ דְּלָאו שְׁחִיטָה הִיא כְּלָל, אֲבָל ״צֵא טְרוֹף״ אֵימָא שְׁחִיטָה שֶׁאֵינָהּ רְאוּיָה שְׁמָהּ שְׁחִיטָה וְלִיבְעֵי כִּסּוּי, קָא מַשְׁמַע לַן כִּדְרַבִּי חִיָּיא בַּר אַבָּא."
    },
    {
      "ref": "Chullin 86a:2",
      "start": 480.0,
      "end": 1946.0,
      "he": "וּלְמַאן דְּאָמַר ״צֵא נְחוֹר״, מַאי טַעְמָא לָא אָמַר ״צֵא טְרוֹף״? וְכִי תֵּימָא קָסָבַר שְׁחִיטָה שֶׁאֵינָהּ רְאוּיָה שְׁמָהּ שְׁחִיטָה, וְהָא אָמַר רַבִּי חִיָּיא בַּר אַבָּא אָמַר רַבִּי יוֹחָנָן: רָאָה רַבִּי דְּבָרָיו שֶׁל רַבִּי שִׁמְעוֹן בְּכִסּוּי הַדָּם, וּשְׁנָאוֹ בִּלְשׁוֹן חֲכָמִים!"
    },
    {
      "ref": "Chullin 86a:17",
      "start": 1946.0,
      "end": 2315.0,
      "he": "אֲמַר לֵיהּ רַב פָּפָּא לְרַב הוּנָא בְּרֵיהּ דְּרַב יְהוֹשֻׁעַ, וְאָמְרִי לַהּ רַב הוּנָא בְּרֵיהּ דְּרַב יְהוֹשֻׁעַ לְרַב פָּפָּא: מַאי אִירְיָא רוֹב? אֲפִילּוּ מִיעוּט נָמֵי, דְּהָא רַבִּי מֵאִיר חָיֵישׁ לְמִיעוּטָא, סְמוֹךְ מִיעוּטָא לַחֲזָקָה, וְאִתְּרַע לֵיהּ רוּבָּא?"
    },
    {
      "ref": "Chullin 86a:18",
      "start": 2044.0,
      "end": 2314.67,
      "he": "דִּתְנַן: תִּינוֹק שֶׁנִּמְצָא בְּצַד הָעִיסָּה וּבָצֵק בְּיָדוֹ, רַבִּי מֵאִיר מְטַהֵר, וַחֲכָמִים מְטַמְּאִין, מִפְּנֵי שֶׁדַּרְכּוֹ שֶׁל תִּינוֹק לְטַפֵּחַ. וְאָמְרִינַן: מַאי טַעְמָא דְּרַבִּי מֵאִיר? קָסָבַר: רוֹב תִּינוֹקוֹת מְטַפְּחִין, וּמִיעוּט אֵין מְטַפְּחִין, וְעִיסָּה זוֹ בְּחֶזְקַת טׇהֳרָה עוֹמֶדֶת,"
    },
    {
      "ref": "Chullin 86b:1",
      "start": 2315.0,
      "end": 2400.33,
      "he": "סְמוֹךְ מִיעוּטָא לַחֲזָקָה וְאִיתְּרַע לֵיהּ רוּבָּא."
    },
    {
      "ref": "Chullin 86b:2",
      "start": 2400.33,
      "end": 2420.0,
      "he": "אִם אָמְרוּ סְפֵק טוּמְאָה לְטַהֵר, יֹאמְרוּ סְפֵק אִיסּוּר לְהַתִּיר?"
    },
    {
      "ref": "Chullin 86b:3",
      "start": 2420.0,
      "end": 2440.67,
      "he": "הוֹרָה רַבִּי כְּרַבִּי מֵאִיר, וְהוֹרָה רַבִּי כַּחֲכָמִים. הֵי מִינַּיְיהוּ דְּאַחֲרִיתָא?"
    }
  ],
