      "start": 1440.07,
      "end": 1440.14,
      "he": "לְאַחַר עֲרִיפָה שֶׁהוּא אָסוּר, וְרַבִּי יוֹחָנָן, וְאִי",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:24",
      "start": 1440.14,
      "end": 1440.21,
      "he": "תֵּימָא רַבִּי אֶלְעָזָר אֲמַר: עֲדַיִין הִיא מַחְלוֹקֶת.",
      "w0": 14,
      "w1": 20,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:25",
      "start": 1523.78,
      "end": 1523.85,
      "he": "אִיכָּא דְּמַתְנֵי לַהּ לְהָא דְּרַב נַחְמָן, אַהָא:",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:25",
      "start": 1523.85,
      "end": 1523.92,
      "he": "״הַמְקַדֵּשׁ בְּפֶטֶר חֲמוֹר אֵינָהּ מְקוּדֶּשֶׁת״. לֵימָא מַתְנִיתִין",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:25",
      "start": 1523.92,
      "end": 1523.99,
      "he": "דְּלָא כְּרַבִּי שִׁמְעוֹן? אָמַר רַב נַחְמָן אָמַר",
      "w0": 14,
      "w1": 20,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:25",
      "start": 1523.99,
      "end": 1524.06,
      "he": "רַבָּה בַּר אֲבוּהּ: לְאַחַר עֲרִיפָה, וְדִבְרֵי הַכֹּל.",
      "w0": 21,
      "w1": 27,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:26",
      "start": 1607.57,
      "end": 1607.65,
      "he": "אִיכָּא דְאָמְרִי: הָא מַנִּי? לָא רַבִּי יְהוּדָה וְלָא",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:26",
      "start": 1607.65,
      "end": 1607.73,
      "he": "רַבִּי שִׁמְעוֹן. אִי רַבִּי שִׁמְעוֹן — תִּיקְדַּשׁ בְּכוּלֵּיהּ,",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:26",
      "start": 1607.73,
      "end": 1607.81,
      "he": "אִי רַבִּי יְהוּדָה — תִּיקְדַּשׁ בְּהָךְ דְּבֵינֵי בֵּינֵי!",
      "w0": 16,
      "w1": 23,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:27",
      "start": 1758.09,
      "end": 1758.2,
      "he": "אָמַר רַבָּה בַּר אֲבוּהּ אָמַר רַב: לְעוֹלָם רַבִּי יְהוּדָה, וּכְגוֹן שֶׁאֵינוֹ",
      "w0": 0,
      "w1": 10,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:27",
      "start": 1758.09,
      "end": 1760.09,
      "he": "שָׁוֶה",
      "w0": 11,
      "w1": 11
    },
    {
      "ref": "Bekhorot 10b:27",
      "start": 1691.36,
      "end": 1691.37,
      "he": "אֶלָּא",
      "w0": 12,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:27",
      "start": 1691.36,
      "end": 1691.36,
      "he": "שֶׁקֶל,",
      "w0": 13,
      "w1": 13
    },
    {
      "ref": "Bekhorot 10b:27",
      "start": 1766.43,
      "end": 1766.47,
      "he": "וְסָבַר לַהּ כְּרַבִּי יוֹסֵי",
      "w0": 14,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:27",
      "start": 1766.43,
      "end": 1766.43,
      "he": "בַּר",
      "w0": 18,
      "w1": 18
    },
    {
      "ref": "Bekhorot 10b:27",
      "start": 1766.43,
      "end": 1766.53,
      "he": "יְהוּדָה. דְּתַנְיָא: ״תִּפְדֶּה״ ״תִּפְדֶּה״ — תִּפְדֶּה מִיָּד, תִּפְדֶּה כׇּל שֶׁהוּא.",
      "w0": 19,
      "w1": 28,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:27",
      "start": 1766.53,
      "end": 1766.62,
      "he": "רַבִּי יוֹסֵי בַּר יְהוּדָה אוֹמֵר: אֵין פְּדִיָּיה פְּחוּתָה מִשֶּׁקֶל.",
      "w0": 29,
      "w1": 37,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:28",
      "start": 1378.46,
      "end": 1378.57,
      "he": "אָמַר מָר: ״תִּפְדֶּה״ ״תִּפְדֶּה״ — תִּפְדֶּה מִיָּד, תִּפְדֶּה כׇּל שֶׁהוּא. פְּשִׁיטָא!",
      "w0": 0,
      "w1": 10,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:29",
      "start": 990.49,
      "end": 990.59,
      "he": "אִיצְטְרִיךְ, סָלְקָא דַּעְתָּךְ אָמֵינָא: הוֹאִיל וְאִיתַּקַּשׁ לִבְכוֹר אָדָם, מָה בְּכוֹר",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:29",
      "start": 990.59,
      "end": 990.68,
      "he": "אָדָם אַחַר שְׁלֹשִׁים וְחָמֵשׁ, הַאי נָמֵי אַחַר שְׁלֹשִׁים וְחָמֵשׁ.",
      "w0": 10,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:30",
      "start": 602.52,
      "end": 602.62,
      "he": "קָא מַשְׁמַע לַן: ״תִּפְדֶּה״ — מִיָּד, ״תִּפְדֶּה״ — כׇּל שֶׁהוּא.",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:31",
      "start": 214.55,
      "end": 214.63,
      "he": "רַבִּי יוֹסֵי בַּר יְהוּדָה אוֹמֵר: אֵין פְּדִיָּיה פְּחוּתָה",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:31",
      "start": 214.63,
      "end": 214.71,
      "he": "מִשֶּׁקֶל. מִמָּה נַפְשָׁךְ: אִי מַקֵּישׁ לִבְכוֹר אָדָם —",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:31",
      "start": 214.71,
      "end": 214.79,
      "he": "חָמֵשׁ לִיבְעֵי, וְאִי לָא מַקֵּישׁ — שֶׁקֶל מְנָא",
      "w0": 16,
      "w1": 23,
      "estimated": true
    },
    {
      "ref": "Bekhorot 10b:31",
      "start": 214.55,
      "end": 214.55,
