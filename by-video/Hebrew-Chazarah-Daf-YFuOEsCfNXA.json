    },
    {
      "ref": "Chullin 106a:15",
      "start": 814.21,
      "end": 814.28,
      "he": "אַיְיתוֹ לְקַמַּיְיהוּ כַּלְכַּלָּה דְּפֵירֵי, וַאֲכַלוּ וְלָא מָשׁוּ",
