    {
      "ref": "Chullin 106a:15",
      "start": 814.3,
      "end": 814.37,
      "he": "יָדַיִם לְפֵירוֹת, וּשְׁמַע מִינַּהּ אֵין מְזַמְּנִין עַל",
      "w0": 35,
      "w1": 41,
      "estimated": true
    },
    {
      "ref": "Chullin 106a:15",
      "start": 814.37,
      "end": 814.45,
      "he": "הַפֵּירוֹת, וּשְׁמַע מִינַּהּ שְׁנַיִם שֶׁאָכְלוּ – מִצְוָה לֵיחָלֵק.",
      "w0": 42,
      "w1": 49,
      "estimated": true
    },
    {
      "ref": "Chullin 106a:16",
      "start": 821.82,
      "end": 821.91,
      "he": "תַּנְיָא נָמֵי הָכִי: שְׁנַיִם שֶׁאָכְלוּ – מִצְוָה לֵיחָלֵק. בַּמֶּה",
      "w0": 0,
