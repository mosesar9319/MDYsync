    },
    {
      "ref": "Chullin 106a:15",
      "start": 814.15,
      "end": 814.23,
      "he": "וְלָא יְהַבוּ לִי מִידֵּי, וּבָרֵיךְ חַד חַד לְחוֹדֵיהּ.",
      "w0": 20,
      "w1": 27,
      "estimated": true
    },
    {
      "ref": "Chullin 106a:15",
      "start": 814.23,
      "end": 814.3,
      "he": "שְׁמַע מִינַּהּ תְּלָת: שְׁמַע מִינַּהּ אֵין נְטִילַת",
      "w0": 28,
      "w1": 34,
      "estimated": true
