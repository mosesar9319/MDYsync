      "w1": 3
    },
    {
      "ref": "Bekhorot 22a:5",
      "start": 2211.41,
      "end": 2211.48,
      "he": "פְּתִיחַת הַקֶּבֶר, עַד שֶׁיַּעֲגִילוּ רֹאשׁ כְּפִיקָּה. מַאי",
