    },
    {
      "ref": "Bekhorot 22a:6",
      "start": 2503.84,
      "end": 2503.92,
      "he": "אוֹמֵר: שֶׁל עֵרֶב. רַבִּי אֱלִיעֶזֶר בְּרַבִּי צָדוֹק אוֹמֵר:",
      "w0": 11,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Bekhorot 22a:6",
      "start": 2503.92,
      "end": 2504.01,
      "he": "מִשֶּׁיֵּרָאוּ טְפִיפִיּוֹת. מַאי טְפִיפִיּוֹת? אָמַר רַב יְהוּדָה אָמַר שְׁמוּאֵל",
      "w0": 19,
      "w1": 27,
