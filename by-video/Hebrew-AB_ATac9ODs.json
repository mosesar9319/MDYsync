      "start": 2504.09,
      "end": 2504.18,
      "he": "בִּירוּשָׁלַיִם: כִּפְרֵידָה שֶׁכּוֹרַעַת לְהַטִּיל מֵימֶיהָ, וְנִרְאֵית פִּיקָּה מִתּוֹךְ פִּיקָּה.",
      "w0": 36,
      "w1": 44,
      "estimated": true
    },
    {
      "ref": "Bekhorot 22a:7",
      "start": 1971.4,
      "end": 1971.48,
      "he": "אָמַר רַב הוּנָא: שָׁמַעְתִּי שְׁתֵּי פִּיקוֹת, אַחַת שֶׁל",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 22a:7",
      "start": 1971.48,
      "end": 1971.56,
      "he": "שְׁתִי וְאַחַת שֶׁל עֵרֶב, וְאֵין לִי לְפָרֵשׁ. כִּי",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Bekhorot 22a:7",
      "start": 1971.56,
      "end": 1971.64,
      "he": "אֲתָא רַב דִּימִי אָמַר רַבִּי יוֹחָנָן: שָׁלֹשׁ פִּיקוֹת",
      "w0": 16,
      "w1": 23,
      "estimated": true
