    {
      "ref": "Bekhorot 22a:6",
      "start": 2504.01,
      "end": 2504.09,
      "he": "מִשּׁוּם רַבִּי אֱלִיעֶזֶר בְּרַבִּי צָדוֹק: כָּךְ הָיוּ מְפָרְשִׁין",
