      "he": "לָקִישׁ מֵרַבִּי יוֹחָנָן: חִלְּקוֹ מִבַּחוּץ, מַהוּ? אֲמַר לֵיהּ: פָּטוּר.",
      "w0": 10,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:3",
      "start": 2295.29,
      "end": 2295.63,
      "he": "מִבִּפְנִים,",
      "w0": 0,
      "w1": 0
    },
    {
      "ref": "Chullin 103b:3",
      "start": 2295.63,
      "end": 2295.67,
      "he": "מַאי? אֲמַר לֵיהּ: חַיָּיב.",
      "w0": 1,
      "w1": 4,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:4",
      "start": 2305.94,
      "end": 2306.03,
      "he": "כִּי אֲתָא רָבִין אָמַר: חִלְּקוֹ מִבַּחוּץ – פָּטוּר, מִבְּפָנִים",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:4",
      "start": 2306.03,
      "end": 2306.12,
      "he": "– רַבִּי יוֹחָנָן אָמַר חַיָּיב, וְרֵישׁ לָקִישׁ אָמַר פָּטוּר.",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:5",
      "start": 2316.26,
      "end": 2316.34,
      "he": "רַבִּי יוֹחָנָן אָמַר: חַיָּיב, הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת.",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:5",
      "start": 2316.34,
      "end": 2316.42,
      "he": "וְרֵישׁ לָקִישׁ אָמַר: פָּטוּר, אֲכִילָה בְּמֵעָיו בָּעֵינַן וְלֵיכָּא.",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:6",
      "start": 2326.57,
      "end": 2326.64,
      "he": "אֶלָּא לְרַבִּי שִׁמְעוֹן בֶּן לָקִישׁ, הֵיכִי מַשְׁכַּחַתְּ",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:6",
      "start": 2326.64,
      "end": 2326.71,
      "he": "לַהּ דִּמְחַיֵּיב? אָמַר רַב כָּהֲנָא: בִּגְרוֹמִיתָא זְעֵירְתָּא.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:7",
      "start": 2336.88,
      "end": 2336.95,
      "he": "וְרַבִּי אֶלְעָזָר אָמַר: אֲפִילּוּ חִלְּקוֹ מִבַּחוּץ נָמֵי",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:7",
      "start": 2336.95,
      "end": 2337.02,
      "he": "חַיָּיב, מְחוּסַּר קְרִיבָה לָאו כִּמְחוּסַּר מַעֲשֶׂה דָּמֵי.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 2347.19,
      "end": 2347.29,
      "he": "אָמַר רַבִּי שִׁמְעוֹן בֶּן לָקִישׁ: כְּזַיִת שֶׁאָמְרוּ – חוּץ מִשֶּׁל",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 2347.29,
      "end": 2347.38,
      "he": "בֵּין הַשִּׁינַּיִם, וְרַבִּי יוֹחָנָן אָמַר: אַף עִם בֵּין הַשִּׁינַּיִם.",
      "w0": 10,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 2357.51,
      "end": 2357.6,
      "he": "אָמַר רַב פָּפָּא: בְּשֶׁל בֵּין שִׁינַּיִם – דְּכוּלֵּי עָלְמָא",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 2357.6,
      "end": 2357.69,
      "he": "לָא פְּלִיגִי, כִּי פְּלִיגִי – בֵּין הַחֲנִיכַיִים. מָר סָבַר:",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 2357.69,
      "end": 2357.78,
      "he": "הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת, וּמָר סָבַר: אֲכִילָה בְּמֵעָיו בָּעֵינַן.",
      "w0": 18,
      "w1": 26,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 2367.82,
