      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 2398.85,
      "end": 2398.94,
      "he": "וְהָכִי קָאָמַר לֵיהּ: לְמָה לִי חֲצִי זַיִת אַחֵר? לֵימָא",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
