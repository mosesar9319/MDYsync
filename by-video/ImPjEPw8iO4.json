      "estimated": true
    },
    {
      "ref": "Chullin 119b:19",
      "start": 2016.67,
      "end": 2016.78,
      "he": "לָא, מִשּׁוּם שׁוֹמֵר. וּמִי אִיכָּא שׁוֹמֵר עַל גַּבֵּי שׁוֹמֵר? חַלְחוּלֵי מְחַלְחֵל.",
