      "estimated": true
    },
    {
      "ref": "Chullin 119b:18",
      "start": 2015.82,
      "end": 2015.89,
      "he": "שֶׁכְּנֶגְדּוֹ – טָמֵא. מַאי לָאו, מִשּׁוּם יָד?",
      "w0": 15,
