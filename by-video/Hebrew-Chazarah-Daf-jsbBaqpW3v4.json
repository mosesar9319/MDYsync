    {
      "ref": "Chullin 118b:2",
      "start": 2000.34,
      "end": 2000.41,
      "he": "אֶלָּא, מֵעִיקָּרָא כִּי כְּתִיבָא יָד, אַהַכְנָסָה כְּתִיבָא.",
