      "he": "לֵיהּ: מַאי אֲמַר לָךְ? אֲמַר לֵיהּ: שַׁרְיָא נִיהֲלֵיהּ.",
      "w0": 15,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:10",
      "start": 1534.86,
      "end": 1534.93,
      "he": "אֲמַר לֵיהּ הֲדַר עַיְּילַיהּ לְקַמֵּיהּ, אֲמַר: מַאן",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:10",
      "start": 1534.93,
      "end": 1535.0,
      "he": "הַאי דְּקָא מְצַעַר לִי? זִיל אֵימָא לֵיהּ",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:10",
      "start": 1535.0,
      "end": 1535.07,
      "he": "לְמַאן דְּיָתֵיב אַבָּבָא: אֵין בְּגִידִין בְּנוֹתֵן טַעַם.",
      "w0": 14,
      "w1": 20,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:11",
      "start": 1535.86,
      "end": 1535.93,
      "he": "כִּי אֲתוֹ לְקַמֵּיהּ דְּרַבִּי אַמֵּי, מְשַׁדַּר לְהוּ",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:11",
      "start": 1535.93,
      "end": 1536.0,
      "he": "לְקַמֵּיהּ דְּרַבִּי יִצְחָק בֶּן חֲלוּב, דְּמוֹרֵי בַּהּ",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:11",
      "start": 1536.0,
      "end": 1536.08,
      "he": "לְהֶיתֵּירָא מִשּׁוּם דְּרַבִּי יְהוֹשֻׁעַ בֶּן לֵוִי, וְלֵיהּ לָא",
      "w0": 14,
      "w1": 21,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:11",
      "start": 1536.08,
      "end": 1536.15,
      "he": "סְבִירָא לֵיהּ. וְהִלְכְתָא: אֵין בְּגִידִין בְּנוֹתֵן טַעַם.",
      "w0": 22,
      "w1": 28,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:12",
      "start": 1536.86,
      "end": 1536.91,
      "he": "גִּיד הַנָּשֶׁה שֶׁנִּתְבַּשֵּׁל. וְלִיבְטוֹל בְּרוּבָּא!",
      "w0": 0,
      "w1": 4,
      "estimated": true
    }
  ],
