      "he": "וְאֵצֶל עַם הָאָרֶץ, בְּחֶזְקָתָן לַמַּעֲשֵׂר וְלַשְּׁבִיעִית.",
      "w0": 6,
      "w1": 11,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:5",
      "start": 352.62,
      "end": 352.7,
      "he": "אֵצֶל הַגּוֹי — כְּפֵירוֹתָיו, רַבִּי שִׁמְעוֹן אוֹמֵר: דְּמַאי.",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:6",
      "start": 268.72,
      "end": 268.81,
      "he": "אָמַר רַבִּי אֶלְעָזָר: לְהַפְרִישׁ — כּוּלֵּי עָלְמָא לָא פְּלִיגִי,",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:6",
      "start": 268.81,
      "end": 268.89,
      "he": "כִּי פְּלִיגִי — לִיתְּנָן לְכֹהֵן. תַּנָּא קַמָּא סָבַר:",
      "w0": 9,
      "w1": 16,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:6",
      "start": 268.89,
      "end": 268.98,
      "he": "וַדַּאי חַלְּפִינְהוּ, וּבָעֵי מִיתְּנַנְהוּ לְכֹהֵן, וְרַבִּי שִׁמְעוֹן סָבַר: דְּמַאי.",
      "w0": 17,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:7",
      "start": 184.82,
      "end": 184.9,
      "he": "יָתֵיב רַב דִּימִי וְקָאָמַר לְהָא שְׁמַעְתָּא, אֲמַר לֵיהּ",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:7",
      "start": 184.9,
      "end": 184.98,
      "he": "אַבָּיֵי: טַעְמָא דִּמְסַפְּקָא לַן אִי חַלְּפִינְהוּ אִי לָא",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:7",
      "start": 184.98,
      "end": 185.07,
      "he": "חַלְּפִינְהוּ, הָא וַדַּאי חַלְּפִינְהוּ — דְּכוּלֵּי עָלְמָא בָּעֵי לְמִיתְּבִינְהוּ",
      "w0": 16,
      "w1": 24,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:7",
      "start": 185.07,
      "end": 185.15,
      "he": "לְכֹהֵן, וְהָאָמַר רַבִּי שְׁמוּאֵל אָמַר רַבִּי חֲנִינָא: הַלּוֹקֵחַ",
      "w0": 25,
      "w1": 32,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:7",
      "start": 185.15,
      "end": 185.23,
      "he": "טְבָלִים מִן הַגּוֹי מְמוֹרָחִין — מְעַשְּׂרָן וְהֵן שֶׁלּוֹ!",
      "w0": 33,
      "w1": 40,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:8",
      "start": 100.92,
      "end": 100.99,
      "he": "דִּלְמָא כָּאן בִּתְרוּמָה גְּדוֹלָה, כָּאן בִּתְרוּמַת מַעֲשֵׂר!",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:9",
      "start": 17.02,
      "end": 17.1,
      "he": "אַזְכַּרְתַּן מִילְּתָא דְּאָמַר רַבִּי יְהוֹשֻׁעַ בֶּן לֵוִי: מִנַּיִן",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:9",
      "start": 17.1,
      "end": 17.17,
      "he": "לַלּוֹקֵחַ טְבָלִים מְמוֹרָחִין מִן הַגּוֹי שֶׁהוּא פָּטוּר",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:9",
      "start": 17.17,
      "end": 17.25,
      "he": "מִתְּרוּמַת מַעֲשֵׂר? שֶׁנֶּאֱמַר: ״וְאֶל הַלְוִיִּם תְּדַבֵּר וְאָמַרְתָּ אֲלֵיהֶם",
      "w0": 15,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:9",
      "start": 17.02,
      "end": 17.02,
      "he": "כִּי תִקְחוּ",
      "w0": 23,
      "w1": 24
    },
    {
      "ref": "Bekhorot 11b:9",
      "start": 17.02,
      "end": 17.1,
      "he": "מֵאֵת בְּנֵי יִשְׂרָאֵל״, טְבָלִים שֶׁאַתָּה לוֹקֵחַ מִבְּנֵי יִשְׂרָאֵל",
      "w0": 25,
      "w1": 32,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:9",
      "start": 17.1,
      "end": 17.17,
      "he": "— אַתָּה מַפְרִישׁ מֵהֶן תְּרוּמַת מַעֲשֵׂר וְנוֹתְנָהּ",
      "w0": 33,
      "w1": 39,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:9",
      "start": 17.17,
      "end": 17.24,
      "he": "לַכֹּהֵן, טְבָלִים שֶׁאַתָּה לוֹקֵחַ מִן הַגּוֹי —",
      "w0": 40,
      "w1": 46,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:9",
      "start": 17.24,
      "end": 17.32,
      "he": "אִי אַתָּה מַפְרִישׁ מֵהֶן תְּרוּמַת מַעֲשֵׂר וְנוֹתְנָהּ לַכֹּהֵן.",
      "w0": 47,
      "w1": 54,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:10",
      "start": 317.65,
      "end": 317.73,
      "he": "וְאִם מֵת נֶהֱנִים בּוֹ. דְּמִית הֵיכָא? אִילֵּימָא דְּמִית",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:10",
      "start": 317.65,
      "end": 481.15,
      "he": "בֵּי",
      "w0": 8,
      "w1": 8
    },
    {
      "ref": "Bekhorot 11b:10",
      "start": 215.88,
      "end": 215.9,
      "he": "כֹהֵן, וְנֶהֱנֶה",
      "w0": 9,
      "w1": 10,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:10",
      "start": 215.88,
      "end": 215.88,
      "he": "בּוֹ כֹּהֵן",
      "w0": 11,
      "w1": 12
    },
    {
      "ref": "Bekhorot 11b:10",
      "start": 215.88,
      "end": 215.96,
      "he": "— פְּשִׁיטָא, מָמוֹנָא דִּידֵיהּ הוּא! אֶלָּא, דְּמִית בֵּי",
      "w0": 13,
      "w1": 20,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:10",
      "start": 215.96,
      "end": 216.04,
      "he": "בְעָלִים וְנֶהֱנֶה בּוֹ כֹּהֵן — הָא נָמֵי פְּשִׁיטָא!",
      "w0": 21,
      "w1": 28,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:11",
      "start": 482.15,
      "end": 482.25,
      "he": "סָלְקָא דַעְתָּךְ אָמֵינָא, כֹּל כַּמָּה דְּלָא מְטָא לִידֵיהּ לָא זְכָה",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Bekhorot 11b:11",
      "start": 482.25,
      "end": 482.34,
      "he": "בֵּיהּ, קָא מַשְׁמַע לַן דְּמֵעִידָּנָא דְּאַפְרְשֵׁיהּ, בִּרְשׁוּתֵיהּ דְּכֹהֵן קָאֵי.",
      "w0": 10,
