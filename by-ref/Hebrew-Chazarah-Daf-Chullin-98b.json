      "w0": 18,
      "w1": 12
    },
    {
      "ref": "Chullin 99b:2",
      "start": 1537.2,
      "end": 1537.3,
      "he": "שֶׁל חִטִּין שֶׁנָּפַל לְעִיסַּת חִטִּין, וְיֵשׁ בּוֹ כְּדֵי לְחַמֵּץ, בֵּין",
