      "he": "הָוֵי, סֵיפָא בְּשִׁשִּׁים! דְּקָתָנֵי רֵישָׁא: לְהַחְמִיר מִין וּמִינוֹ כֵּיצַד? שְׂאוֹר שֶׁל חִטִּין שֶׁנָּפַל לְעִיסַּת חִטִּין, וְיֵשׁ בּוֹ",
      "w0": 3,
      "w1": 19
    },
    {
      "ref": "Chullin 99b:2",
      "start": 1523.86,
      "end": 1523.86,
      "he": "וְיֵשׁ",
      "w0": 18,
      "w1": 18
    },
    {
      "ref": "Chullin 99b:2",
      "start": 1540.21,
      "end": 1542.21,
