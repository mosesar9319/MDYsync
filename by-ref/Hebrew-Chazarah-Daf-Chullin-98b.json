    },
    {
      "ref": "Chullin 99b:2",
      "start": 1538.2,
      "end": 1538.28,
      "he": "חִטִּין שֶׁנָּפַל לְעִיסַּת חִטִּין, וְיֵשׁ בּוֹ כְּדֵי לְחַמֵּץ,",
      "w0": 14,
      "w1": 21,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:2",
      "start": 1538.28,
      "end": 1538.36,
      "he": "בֵּין יֵשׁ בּוֹ כְּדֵי לְהַעֲלוֹת בְּמֵאָה וְאֶחָד, בֵּין",
      "w0": 22,
      "w1": 29,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:2",
      "start": 1538.36,
      "end": 1538.44,
      "he": "אֵין בּוֹ כְּדֵי לְהַעֲלוֹת בְּמֵאָה וְאֶחָד – אָסוּר.",
      "w0": 30,
      "w1": 37,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:3",
      "start": 1540.65,
      "end": 1540.75,
      "he": "אֵין בּוֹ לְהַעֲלוֹת בְּמֵאָה וְאֶחָד, בֵּין שֶׁיֵּשׁ בּוֹ כְּדֵי לְחַמֵּץ,",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:3",
      "start": 1540.75,
      "end": 1540.85,
      "he": "בֵּין אֵין בּוֹ כְּדֵי לְחַמֵּץ – אָסוּר. רֵישָׁא וְסֵיפָא בִּמְאָה?",
      "w0": 10,
      "w1": 19,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:4",
      "start": 1539.09,
      "end": 1539.15,
      "he": "לָא, רֵישָׁא בִּמְאָה וְחַד, וְסֵיפָא בִּמְאָה.",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:5",
      "start": 1537.53,
      "end": 1537.64,
      "he": "וְכִי יֵשׁ בּוֹ כְּדֵי לְחַמֵּץ בִּמְאָה וְחַד, אַמַּאי לָא בְּטִיל? אִישְׁתִּיק.",
      "w0": 0,
      "w1": 10,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:6",
      "start": 1535.98,
      "end": 1536.07,
      "he": "אֲמַר לֵיהּ: דִּלְמָא שָׁאנֵי שְׂאוֹר דְּחִימּוּצוֹ קָשֶׁה. אֲמַר לֵיהּ:",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:6",
      "start": 1536.07,
      "end": 1536.16,
      "he": "אַדְכַּרְתַּן מִילְּתָא דְּאָמַר רַבִּי יוֹסֵי בְּרַבִּי חֲנִינָא: לֹא כׇּל",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:6",
      "start": 1536.16,
      "end": 1536.24,
      "he": "הַשִּׁיעוּרִין שָׁוִין, שֶׁהֲרֵי צִיר שִׁיעוּרוֹ קָרוֹב לְמָאתַיִם. דִּתְנַן:",
      "w0": 18,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:6",
      "start": 1536.24,
      "end": 1536.33,
      "he": "דָּג טָמֵא צִירוֹ אָסוּר, רַבִּי יְהוּדָה אוֹמֵר: רְבִיעִית בְּסָאתַיִם.",
      "w0": 26,
      "w1": 34,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:7",
      "start": 1534.42,
      "end": 1534.48,
      "he": "וְהָאָמַר רַבִּי יְהוּדָה: מִין בְּמִינוֹ לֹא",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:7",
      "start": 1534.48,
      "end": 1534.54,
      "he": "בָּטֵיל? שָׁאנֵי צִיר, דְּזֵיעָה בְּעָלְמָא הוּא.",
      "w0": 6,
      "w1": 11,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:8",
      "start": 1532.86,
      "end": 1532.94,
      "he": "כֵּיצַד מְשַׁעֲרִינַן? אָמַר רַב הוּנָא: כְּבָשָׂר בְּרָאשֵׁי לְפָתוֹת.",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:8",
      "start": 1532.94,
      "end": 1533.02,
      "he": "מַתְנִיתִין דְּלָא כְּהַאי תַּנָּא, דְּתַנְיָא: רַבִּי יִשְׁמָעֵאל בְּנוֹ",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:8",
      "start": 1532.86,
      "end": 1532.86,
      "he": "שֶׁל רַבִּי",
      "w0": 16,
      "w1": 17
    },
    {
      "ref": "Chullin 99b:8",
      "start": 1532.86,
      "end": 1532.94,
      "he": "יוֹחָנָן בֶּן בְּרוֹקָה אוֹמֵר: אֵין בְּגִידִין בְּנוֹתֵן טַעַם.",
      "w0": 18,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:9",
      "start": 1533.86,
      "end": 1533.94,
      "he": "הָהוּא דַּאֲתָא לְקַמֵּיהּ דְּרַבִּי חֲנִינָא, הֲוָה יָתֵיב רַבִּי",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:9",
      "start": 1533.94,
      "end": 1534.01,
      "he": "יְהוּדָה בַּר זְבִינָא אַבָּבָא. כִּי נְפַק, אֲמַר",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:9",
      "start": 1534.01,
      "end": 1534.09,
      "he": "לֵיהּ: מַאי אֲמַר לָךְ? אֲמַר לֵיהּ: שַׁרְיָא נִיהֲלֵיהּ.",
      "w0": 15,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:10",
      "start": 1534.86,
      "end": 1534.93,
      "he": "אֲמַר לֵיהּ הֲדַר עַיְּילַיהּ לְקַמֵּיהּ, אֲמַר: מַאן",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:10",
      "start": 1534.93,
      "end": 1535.0,
      "he": "הַאי דְּקָא מְצַעַר לִי? זִיל אֵימָא לֵיהּ",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:10",
      "start": 1535.0,
      "end": 1535.07,
      "he": "לְמַאן דְּיָתֵיב אַבָּבָא: אֵין בְּגִידִין בְּנוֹתֵן טַעַם.",
      "w0": 14,
      "w1": 20,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:11",
      "start": 1535.86,
      "end": 1535.93,
      "he": "כִּי אֲתוֹ לְקַמֵּיהּ דְּרַבִּי אַמֵּי, מְשַׁדַּר לְהוּ",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:11",
      "start": 1535.93,
      "end": 1536.0,
      "he": "לְקַמֵּיהּ דְּרַבִּי יִצְחָק בֶּן חֲלוּב, דְּמוֹרֵי בַּהּ",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:11",
      "start": 1536.0,
      "end": 1536.08,
      "he": "לְהֶיתֵּירָא מִשּׁוּם דְּרַבִּי יְהוֹשֻׁעַ בֶּן לֵוִי, וְלֵיהּ לָא",
      "w0": 14,
      "w1": 21,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:11",
      "start": 1536.08,
      "end": 1536.15,
      "he": "סְבִירָא לֵיהּ. וְהִלְכְתָא: אֵין בְּגִידִין בְּנוֹתֵן טַעַם.",
      "w0": 22,
      "w1": 28,
      "estimated": true
    },
    {
      "ref": "Chullin 99b:12",
      "start": 1536.86,
      "end": 1536.91,
      "he": "גִּיד הַנָּשֶׁה שֶׁנִּתְבַּשֵּׁל. וְלִיבְטוֹל בְּרוּבָּא!",
