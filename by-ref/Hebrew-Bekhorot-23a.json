      "w1": 31
    },
    {
      "ref": "Bekhorot 23b:4",
      "start": 3727.06,
      "end": 3727.08,
      "he": "נָגְעוּ בָּהּ.",
      "w0": 32,
      "w1": 33,
      "estimated": true
    },
    {
      "ref": "Bekhorot 23b:5",
      "start": 3728.06,
      "end": 3728.14,
      "he": "מַאי אִירְיָא מִשּׁוּם בִּיטּוּל בְּרוֹב? תִּיפּוֹק לִי דְּלָא",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 23b:5",
      "start": 3728.14,
      "end": 3728.22,
      "he": "אִיתְחֲזִי כְּלָל! הָא נָמֵי אִיתְחֲזִי מֵעִיקָּרָא אַגַּב אִימֵּיהּ.",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Bekhorot 23b:6",
      "start": 3729.06,
      "end": 3729.14,
      "he": "תְּנַן הָתָם: רַבִּי אֱלִיעֶזֶר בֶּן יַעֲקֹב אוֹמֵר: צִיר",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 23b:6",
      "start": 3729.14,
      "end": 3729.22,
      "he": "טָהוֹר שֶׁנָּפַל לְתוֹכוֹ מַיִם כׇּל שֶׁהוּא — טָמֵא.",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Bekhorot 23b:6",
      "start": 3729.22,
      "end": 3729.3,
      "he": "אָמַר רַב נַחְמָן אָמַר רַבָּה בַּר אֲבוּהּ: זֹאת",
      "w0": 16,
      "w1": 23,
      "estimated": true
    },
    {
      "ref": "Bekhorot 23b:6",
      "start": 3729.3,
      "end": 3729.37,
      "he": "אוֹמֶרֶת נֶחְשְׁדוּ עַמֵּי הָאָרֶץ לְעָרֵב מֶחֱצָה בַּצִּיר.",
      "w0": 24,
      "w1": 30,
      "estimated": true
    },
    {
      "ref": "Bekhorot 23b:6",
      "start": 3729.37,
      "end": 3729.45,
      "he": "וּלְמָה לִי מֶחֱצָה? אֲפִילּוּ בְּצִיר מִמֶּחֱצָה נָמֵי! וְהָנֵי",
      "w0": 31,
      "w1": 38,
      "estimated": true
    },
    {
      "ref": "Bekhorot 23b:6",
      "start": 3729.45,
