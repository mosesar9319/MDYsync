      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:6",
      "start": 1512.82,
      "end": 1512.89,
      "he": "אֶלָּא לְרַבִּי שִׁמְעוֹן בֶּן לָקִישׁ, הֵיכִי מַשְׁכַּחַתְּ",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:6",
      "start": 1512.89,
      "end": 1512.96,
      "he": "לַהּ דִּמְחַיֵּיב? אָמַר רַב כָּהֲנָא: בִּגְרוֹמִיתָא זְעֵירְתָּא.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:7",
      "start": 1513.82,
      "end": 1513.89,
      "he": "וְרַבִּי אֶלְעָזָר אָמַר: אֲפִילּוּ חִלְּקוֹ מִבַּחוּץ נָמֵי",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:7",
      "start": 1513.89,
      "end": 1513.96,
      "he": "חַיָּיב, מְחוּסַּר קְרִיבָה לָאו כִּמְחוּסַּר מַעֲשֶׂה דָּמֵי.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 1514.82,
      "end": 1514.92,
      "he": "אָמַר רַבִּי שִׁמְעוֹן בֶּן לָקִישׁ: כְּזַיִת שֶׁאָמְרוּ – חוּץ מִשֶּׁל",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 1514.92,
      "end": 1515.01,
      "he": "בֵּין הַשִּׁינַּיִם, וְרַבִּי יוֹחָנָן אָמַר: אַף עִם בֵּין הַשִּׁינַּיִם.",
      "w0": 10,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 1515.82,
      "end": 1515.91,
      "he": "אָמַר רַב פָּפָּא: בְּשֶׁל בֵּין שִׁינַּיִם – דְּכוּלֵּי עָלְמָא",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 1515.91,
      "end": 1516.0,
      "he": "לָא פְּלִיגִי, כִּי פְּלִיגִי – בֵּין הַחֲנִיכַיִים. מָר סָבַר:",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 1516.0,
      "end": 1516.09,
      "he": "הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת, וּמָר סָבַר: אֲכִילָה בְּמֵעָיו בָּעֵינַן.",
      "w0": 18,
      "w1": 26,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 1516.82,
      "end": 1516.9,
      "he": "אָמַר רַבִּי אַסִּי אָמַר רַבִּי יוֹחָנָן: אָכַל חֲצִי",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 1516.9,
      "end": 1516.97,
      "he": "זַיִת וֶהֱקִיאוֹ, וְחָזַר וְאָכַל חֲצִי זַיִת אַחֵר",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 1516.97,
      "end": 1517.05,
      "he": "– חַיָּיב. מַאי טַעְמָא? הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת.",
      "w0": 15,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:11",
      "start": 1517.82,
      "end": 1517.91,
      "he": "בְּעָא רַבִּי אֶלְעָזָר מֵרַבִּי אַסִּי: אָכַל חֲצִי זַיִת וֶהֱקִיאוֹ",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:11",
      "start": 1517.91,
      "end": 1517.99,
      "he": "וְחָזַר וַאֲכָלוֹ, מַהוּ? מַאי קָא מִיבַּעְיָא לֵיהּ? אִי",
      "w0": 9,
      "w1": 16,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:11",
      "start": 1517.99,
      "end": 1518.08,
      "he": "הָוֵי עִיכּוּל אִי לָא הָוֵי עִיכּוּל, וְתִיבְּעֵי לֵיהּ כְּזַיִת!",
      "w0": 17,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:12",
      "start": 1518.82,
      "end": 1518.88,
      "he": "אֶלָּא, אִי בָּתַר גְּרוֹנוֹ אָזְלִינַן, אִי",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:12",
      "start": 1518.88,
      "end": 1518.95,
      "he": "בָּתַר מֵעָיו אָזְלִינַן. וְתִפְשׁוֹט לֵיהּ מִדְּרַבִּי אַסִּי!",
      "w0": 6,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 1519.82,
      "end": 1519.91,
      "he": "רַבִּי אַסִּי גְּמָרֵיהּ אִיעֲקַר לֵיהּ, וַאֲתָא רַבִּי אֶלְעָזָר לְאַדְכּוֹרֵיהּ,",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 1519.91,
      "end": 1520.0,
      "he": "וְהָכִי קָאָמַר לֵיהּ: לְמָה לִי חֲצִי זַיִת אַחֵר? לֵימָא",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 1520.0,
      "end": 1520.08,
      "he": "מָר בְּדִידֵיהּ, דְּאִיכָּא לְמִשְׁמַע מִינַּהּ תַּרְתֵּי: שָׁמְעִינַן מִינַּהּ",
      "w0": 18,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 1520.08,
      "end": 1520.17,
      "he": "דְּלָא הָוֵי עִיכּוּל, וְשָׁמְעִינַן מִינַּהּ דַּהֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת.",
      "w0": 26,
      "w1": 34,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:14",
      "start": 1520.82,
      "end": 1520.9,
      "he": "אִישְׁתִּיק וְלָא אֲמַר לֵיהּ וְלָא מִידֵּי, אֲמַר לֵיהּ:",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:14",
      "start": 1520.9,
      "end": 1520.97,
      "he": "מוֹפֵת הַדּוֹר, לָא זִימְנִין סַגִּיאִין אָמְרַתְּ קַמֵּיהּ",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:14",
      "start": 1520.97,
      "end": 1521.05,
      "he": "דְּרַבִּי יוֹחָנָן, וְאָמַר לָךְ: הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת?",
      "w0": 15,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:15",
      "start": 1521.82,
