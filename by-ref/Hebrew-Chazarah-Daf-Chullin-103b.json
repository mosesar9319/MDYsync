    {
      "ref": "Chullin 103b:1",
      "start": 1490.82,
      "end": 1490.89,
      "he": "מִכְּלָלוֹ, אֲבָל אֵבֶר דְּלֹא הוּתַּר מִכְּלָלוֹ –",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:1",
      "start": 1490.82,
      "end": 1490.82,
      "he": "לָא.",
      "w0": 7,
      "w1": 7
    },
    {
      "ref": "Chullin 103b:2",
      "start": 1490.82,
      "end": 1490.82,
      "he": "כִּי",
      "w0": 0,
      "w1": 0
    },
    {
      "ref": "Chullin 103b:2",
      "start": 1490.82,
      "end": 1490.91,
      "he": "אֲתָא רַב דִּימִי אָמַר: בְּעָא מִינֵּיהּ רַבִּי שִׁמְעוֹן בֶּן",
      "w0": 1,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:2",
      "start": 1490.91,
      "end": 1491.0,
      "he": "לָקִישׁ מֵרַבִּי יוֹחָנָן: חִלְּקוֹ מִבַּחוּץ, מַהוּ? אֲמַר לֵיהּ: פָּטוּר.",
      "w0": 10,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:3",
      "start": 1491.82,
      "end": 1491.87,
      "he": "מִבִּפְנִים, מַאי? אֲמַר לֵיהּ: חַיָּיב.",
      "w0": 0,
      "w1": 4,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:4",
      "start": 1492.82,
      "end": 1492.91,
      "he": "כִּי אֲתָא רָבִין אָמַר: חִלְּקוֹ מִבַּחוּץ – פָּטוּר, מִבְּפָנִים",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:4",
      "start": 1492.91,
      "end": 1493.0,
      "he": "– רַבִּי יוֹחָנָן אָמַר חַיָּיב, וְרֵישׁ לָקִישׁ אָמַר פָּטוּר.",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:5",
      "start": 1493.82,
      "end": 1493.9,
      "he": "רַבִּי יוֹחָנָן אָמַר: חַיָּיב, הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת.",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:5",
      "start": 1493.9,
      "end": 1493.98,
      "he": "וְרֵישׁ לָקִישׁ אָמַר: פָּטוּר, אֲכִילָה בְּמֵעָיו בָּעֵינַן וְלֵיכָּא.",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:6",
      "start": 1494.82,
      "end": 1494.89,
      "he": "אֶלָּא לְרַבִּי שִׁמְעוֹן בֶּן לָקִישׁ, הֵיכִי מַשְׁכַּחַתְּ",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:6",
      "start": 1494.89,
      "end": 1494.96,
      "he": "לַהּ דִּמְחַיֵּיב? אָמַר רַב כָּהֲנָא: בִּגְרוֹמִיתָא זְעֵירְתָּא.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:7",
      "start": 1495.82,
      "end": 1495.89,
      "he": "וְרַבִּי אֶלְעָזָר אָמַר: אֲפִילּוּ חִלְּקוֹ מִבַּחוּץ נָמֵי",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:7",
      "start": 1495.89,
      "end": 1495.96,
      "he": "חַיָּיב, מְחוּסַּר קְרִיבָה לָאו כִּמְחוּסַּר מַעֲשֶׂה דָּמֵי.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 1496.82,
      "end": 1496.92,
      "he": "אָמַר רַבִּי שִׁמְעוֹן בֶּן לָקִישׁ: כְּזַיִת שֶׁאָמְרוּ – חוּץ מִשֶּׁל",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 1496.92,
      "end": 1497.01,
      "he": "בֵּין הַשִּׁינַּיִם, וְרַבִּי יוֹחָנָן אָמַר: אַף עִם בֵּין הַשִּׁינַּיִם.",
      "w0": 10,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 1497.82,
      "end": 1497.91,
      "he": "אָמַר רַב פָּפָּא: בְּשֶׁל בֵּין שִׁינַּיִם – דְּכוּלֵּי עָלְמָא",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 1497.91,
      "end": 1498.0,
