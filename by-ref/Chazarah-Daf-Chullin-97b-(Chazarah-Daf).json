      "he": "לֵיהּ רַב אַחָא בְּרֵיהּ דְּרָבָא לְרַב אָשֵׁי:",
      "w0": 1,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):3",
      "start": 1759.4,
      "end": 1759.47,
      "he": "וְכֹל ״הַכֹּל״ לְכַתְּחִלָּה הוּא? אֶלָּא מֵעַתָּה: הַכֹּל",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):3",
      "start": 1759.33,
      "end": 1759.33,
      "he": "מְמִירִין,",
      "w0": 15,
      "w1": 15
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):3",
      "start": 1705.0,
      "end": 1705.03,
      "he": "אֶחָד הָאֲנָשִׁים וְאֶחָד",
      "w0": 16,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):3",
      "start": 1705.0,
      "end": 1705.0,
      "he": "הַנָּשִׁים",
      "w0": 19,
      "w1": 19
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):3",
      "start": 1705.0,
      "end": 1705.08,
      "he": "– הָכִי נָמֵי דִּלְכַתְּחִלָּה הוּא? וְהָא כְּתִיב: ״לֹא",
      "w0": 20,
      "w1": 27,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):3",
      "start": 1705.08,
      "end": 1705.17,
      "he": "יַחֲלִיפֶנּוּ וְלֹא יָמִיר אֹתוֹ טוֹב בְּרָע אוֹ רַע בְּטוֹב״!",
      "w0": 28,
      "w1": 36,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):4",
      "start": 1791.33,
      "end": 1791.39,
      "he": "הָתָם, כִּדְקָתָנֵי טַעְמָא: לֹא שֶׁהָאָדָם רַשַּׁאי",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):4",
      "start": 1791.39,
      "end": 1791.46,
      "he": "לְהָמִיר, אֶלָּא שֶׁאִם הֵמִיר – מוּמָר, וְסוֹפֵג",
      "w0": 6,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):4",
      "start": 1791.33,
      "end": 1791.33,
      "he": "אֶת הָאַרְבָּעִים.",
      "w0": 13,
      "w1": 14
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):5",
      "start": 1792.67,
      "end": 1792.73,
      "he": "אֶלָּא הַכֹּל מַעֲרִיכִין וְנֶעֱרָכִין, נוֹדְרִין וְנִידָּרִין,",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):5",
      "start": 1792.73,
      "end": 1792.8,
      "he": "הָכִי נָמֵי דִּלְכַתְּחִלָּה? וְהָא כְּתִיב: ״וְכִי תֶחְדַּל",
      "w0": 6,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):5",
      "start": 1792.67,
      "end": 1793.0,
      "he": "לִנְדֹּר לֹא",
      "w0": 13,
      "w1": 14
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):5",
      "start": 1793.0,
      "end": 1793.03,
      "he": "יִהְיֶה בְךָ חֵטְא״!",
      "w0": 15,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):6",
      "start": 1793.67,
      "end": 1793.75,
      "he": "וּכְתִיב: ״טוֹב אֲשֶׁר לֹא תִדֹּר מִשֶּׁתִּדּוֹר וְלֹא תְשַׁלֵּם״,",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 98b (Chazarah Daf):6",
      "start": 1793.75,
      "end": 1793.82,
      "he": "וְתַנְיָא: טוֹב מִזֶּה וּמִזֶּה שֶׁאֵינוֹ נוֹדֵר כׇּל",
      "w0": 8,
