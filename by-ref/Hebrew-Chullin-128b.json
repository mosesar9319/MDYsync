    },
    {
      "ref": "Chullin 128b:11",
      "start": 3802.09,
      "end": 3802.18,
      "he": "יָכוֹל יְהֵא בָּשָׂר הַפּוֹרֵשׁ מִן הַחַי טָמֵא? תַּלְמוּד לוֹמַר",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:11",
      "start": 3802.18,
      "end": 3802.27,
      "he": "״וְכִי יָמוּת מִן הַבְּהֵמָה״ – מָה מִיתָה שֶׁאֵינָהּ עוֹשָׂה",
      "w0": 18,
      "w1": 26,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:11",
      "start": 3802.27,
      "end": 3802.36,
      "he": "חֲלִיפִין, אַף כֹּל שֶׁאֵינוֹ עוֹשֶׂה חֲלִיפִין, דִּבְרֵי רַבִּי יוֹסֵי.",
      "w0": 27,
      "w1": 35,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:12",
      "start": 3803.0,
      "end": 3803.07,
      "he": "רַבִּי עֲקִיבָא אוֹמֵר: ״בְּהֵמָה״, מָה בְּהֵמָה –",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:12",
      "start": 3803.07,
      "end": 3803.14,
      "he": "גִּידִים וַעֲצָמוֹת, אַף כֹּל – גִּידִים וַעֲצָמוֹת.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:12",
      "start": 3803.14,
      "end": 3803.22,
      "he": "רַבִּי אוֹמֵר: ״בְּהֵמָה״ מָה בְּהֵמָה – בָּשָׂר גִּידִים",
      "w0": 14,
      "w1": 21,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:12",
      "start": 3803.22,
      "end": 3803.29,
      "he": "וַעֲצָמוֹת, אַף כֹּל – בָּשָׂר גִּידִים וַעֲצָמוֹת.",
      "w0": 22,
      "w1": 28,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:13",
      "start": 3804.0,
      "end": 3804.09,
      "he": "מַאי אִיכָּא בֵּין רַבִּי לְרַבִּי עֲקִיבָא? אִיכָּא בֵּינַיְיהוּ אַרְכוּבָּה.",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:14",
      "start": 3805.0,
      "end": 3805.08,
      "he": "בֵּין רַבִּי עֲקִיבָא לְרַבִּי יוֹסֵי הַגְּלִילִי, מַאי אִיכָּא",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:14",
      "start": 3805.08,
      "end": 3805.17,
      "he": "בֵּינַיְיהוּ? אָמַר רַב פָּפָּא: כּוּלְיָא וְנִיב שְׂפָתַיִם אִיכָּא בֵּינַיְיהוּ.",
      "w0": 8,
      "w1": 16,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:15",
      "start": 3806.0,
      "end": 3806.08,
      "he": "תַּנְיָא נָמֵי גַּבֵּי שְׁרָצִים כְּהַאי גַּוְונָא: יָכוֹל בָּשָׂר",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:15",
      "start": 3806.08,
      "end": 3806.16,
      "he": "הַפּוֹרֵשׁ מִן הַשְּׁרָצִים יְהֵא טָמֵא? תַּלְמוּד לוֹמַר ״בְּמוֹתָם״",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:15",
      "start": 3806.16,
      "end": 3806.23,
