      "w0": 10,
      "w1": 19,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:20",
      "start": 3811.0,
      "end": 3811.08,
      "he": "תָּנוּ רַבָּנַן: הַחוֹתֵךְ כְּזַיִת בָּשָׂר מֵאֵבֶר מִן הַחַי,",
      "w0": 0,
