      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 128b:21",
      "start": 3812.0,
      "end": 3812.07,
      "he": "חִישֵּׁב עָלָיו, וְאַחַר כָּךְ חֲתָכוֹ – טָמֵא.",
