      "he": "בְּכוֹר צֹאנֶךָ״ — אֲבָל אַתָּה גּוֹזֵז בְּכוֹר חֲמוֹר.",
      "w0": 15,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Bekhorot 9b:15",
      "start": 434.26,
      "end": 434.35,
      "he": "בִּשְׁלָמָא לְרַבִּי שִׁמְעוֹן, הַיְינוּ דִּכְתִיב תְּרֵי קְרָאֵי, אֶלָּא לְרַבִּי",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Bekhorot 9b:15",
      "start": 434.35,
      "end": 434.43,
      "he": "יְהוּדָה, תְּרֵי קְרָאֵי לְמַעוֹטֵי שֶׁלְּךָ וְשֶׁל אֲחֵרִים לְמָה",
      "w0": 9,
      "w1": 16,
      "estimated": true
    },
    {
      "ref": "Bekhorot 9b:15",
      "start": 434.43,
      "end": 434.52,
      "he": "לִי? וְתוּ לְרַבִּי יְהוּדָה, בְּכוֹר אָדָם נָמֵי נֵימָא דַּאֲסִיר!",
      "w0": 17,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Bekhorot 9b:16",
      "start": 426.13,
      "end": 426.22,
      "he": "אֶלָּא דְּכוּלֵּי עָלְמָא ״שׁוֹרֶךָ״ לְמַעוֹטֵי בְּכוֹר אָדָם הוּא דַּאֲתָא,",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Bekhorot 9b:16",
      "start": 426.22,
      "end": 426.3,
      "he": "כִּי פְּלִיגִי בְּ״צֹאנֶךָ״. דְּרַבִּי יְהוּדָה לְטַעְמֵיהּ, דְּאָמַר: שׁוּתָּפוּת",
      "w0": 9,
      "w1": 16,
      "estimated": true
    },
    {
      "ref": "Bekhorot 9b:16",
      "start": 426.3,
      "end": 426.39,
      "he": "גּוֹי חַיֶּיבֶת בִּבְכוֹרָה, וְכִי אִיצְטְרִיךְ קְרָא לְמִישְׁרֵי בְּגִזָּה וַעֲבוֹדָה.",
      "w0": 17,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Bekhorot 9b:17",
      "start": 418.0,
      "end": 418.1,
      "he": "וְרַבִּי שִׁמְעוֹן סָבַר: שׁוּתָּפוּת גּוֹי פְּטוּרָה מִן הַבְּכוֹרָה, וּלְעִנְיַן גִּזָּה",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Bekhorot 9b:17",
      "start": 418.1,
      "end": 418.19,
      "he": "וַעֲבוֹדָה לָא אִיצְטְרִיךְ קְרָא, כִּי אִיצְטְרִיךְ קְרָא לְפֶטֶר חֲמוֹר.",
      "w0": 10,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Bekhorot 9b:18",
      "start": 409.86,
      "end": 409.94,
      "he": "בִּשְׁלָמָא לְרַבִּי יְהוּדָה, הַיְינוּ דִּכְתִיב ״צֹאנֶךָ״ וְ״שׁוֹרֶךָ״, אַטּוּ",
      "w0": 0,
