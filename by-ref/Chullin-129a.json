      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:9",
      "start": 1036.49,
      "end": 1036.56,
      "he": "לְהַאֲכִילוֹ לַאֲחֵרִים – קָרוּי אוֹכֶל, אוֹכֶל שֶׁאִי",
