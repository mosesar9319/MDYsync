    {
      "ref": "Chullin 129b:3",
      "start": 1030.5,
      "end": 1030.59,
      "he": "טָהוֹר, וְאִם לָאו – טָמֵא. וְאָמְרִינַן לָךְ: מַאי טַעְמָא",
      "w0": 17,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:3",
      "start": 1030.59,
      "end": 1030.67,
      "he": "דְּרַבִּי יְהוּדָה? וְאָמְרַתְּ לַן: הוֹאִיל וּמְעוֹרֶה – מְעוֹרֶה.",
      "w0": 26,
      "w1": 33,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:4",
      "start": 1031.33,
      "end": 1031.41,
      "he": "אֲמַר לֵיהּ, אַמְּצִיעֲתָא: נִשְׁחֲטָה הַבְּהֵמָה, הוּכְשְׁרָה בְּדָמֶיהָ –",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:4",
      "start": 1031.41,
      "end": 1031.49,
      "he": "דִּבְרֵי רַבִּי מֵאִיר; רַבִּי שִׁמְעוֹן אוֹמֵר: לֹא הוּכְשְׁרוּ.",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:5",
      "start": 1032.33,
      "end": 1032.42,
      "he": "(אָמַר רַבִּי אַסִּי) אָמַר רַבִּי יוֹחָנָן: מַאי טַעְמָא דְּרַבִּי",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:5",
      "start": 1032.42,
      "end": 1032.51,
      "he": "שִׁמְעוֹן? אָמַר קְרָא ״מִכׇּל הָאֹכֶל אֲשֶׁר יֵאָכֵל״ – אוֹכֶל",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:5",
      "start": 1032.51,
      "end": 1032.59,
      "he": "שֶׁאַתָּה יָכוֹל לְהַאֲכִילוֹ לַאֲחֵרִים – קָרוּי אוֹכֶל, אוֹכֶל",
      "w0": 18,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:5",
      "start": 1032.59,
      "end": 1032.68,
      "he": "שֶׁאֵין אַתָּה יָכוֹל לְהַאֲכִילוֹ לַאֲחֵרִים – אֵין קָרוּי אוֹכֶל.",
      "w0": 26,
      "w1": 34,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:6",
      "start": 1033.33,
      "end": 1033.38,
      "he": "וְדִילְמָא טַעְמָא דְּרַבִּי שִׁמְעוֹן בְּהָהִיא",
      "w0": 0,
      "w1": 4,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:7",
      "start": 1034.33,
      "end": 1034.38,
      "he": "אִי כִּדְרָבָא, אִי כִּדְרַבִּי יוֹחָנָן?",
      "w0": 0,
      "w1": 4,
      "estimated": true
    },
    {
      "ref": "Chullin 129b:8",
