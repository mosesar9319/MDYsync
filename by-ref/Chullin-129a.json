      "estimated": true
    },
    {
      "ref": "Chullin 129b:10",
      "start": 1037.41,
      "end": 1037.48,
      "he": "הָאָדָם – הַבָּשָׂר טָהוֹר. הָאֵבֶר מְטַמֵּא מִשּׁוּם",
