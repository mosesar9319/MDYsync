      "w0": 29,
      "w1": 36,
      "estimated": true
    },
    {
      "ref": "Bekhorot 40b:9",
      "start": 1162.84,
      "end": 1162.91,
      "he": "גְּדוֹלָה כִּשְׁתַּיִם שֶׁבַּחֲבֶירְתָּהּ, וְלֹא הוֹדוּ לוֹ חֲכָמִים.",
      "w0": 37,
      "w1": 43,
      "estimated": true
    },
    {
      "ref": "Bekhorot 40b:10",
      "start": 1163.47,
      "end": 1163.57,
      "he": "גְּמָ׳ לְמֵימְרָא דְּיַבֶּלֶת הָוֵי מוּמָא? וּרְמִינְהוּ: וְאֵלּוּ שֶׁאֵין שׁוֹחֲטִין עֲלֵיהֶן",
