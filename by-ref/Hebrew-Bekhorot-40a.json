      "w1": 23,
      "estimated": true
    },
    {
      "ref": "Bekhorot 40b:7",
      "start": 1160.71,
      "end": 1160.8,
      "he": "אַרְבַּע אֵינוֹ מוּם. מֵיתִיבִי: בַּגְּדִי — אַחַת הֲרֵי זֶה",
      "w0": 24,
      "w1": 32,
      "estimated": true
    },
    {
      "ref": "Bekhorot 40b:7",
      "start": 1160.8,
      "end": 1160.88,
      "he": "מוּם, שְׁתַּיִם אֵינוֹ מוּם. בַּטָּלֶה — שְׁתַּיִם הֲרֵי",
      "w0": 33,
      "w1": 40,
      "estimated": true
    },
    {
      "ref": "Bekhorot 40b:7",
      "start": 1160.88,
