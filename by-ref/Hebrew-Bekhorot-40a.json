    {
      "ref": "Bekhorot 40b:12",
      "start": 1165.57,
      "end": 1165.67,
      "he": "לָא קַשְׁיָא, הָא דְּאִית בַּהּ עֶצֶם, הָא דְּלֵית בַּהּ עֶצֶם.",
