      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Bekhorot 40b:11",
      "start": 1164.54,
      "end": 1164.61,
      "he": "קַשְׁיָא: הָא — בְּגוּפוֹ, הָא — בְּעֵינוֹ.",
