      "end": 1161.66,
      "he": "נָמֵי בִּגְדִי, וְלָא הִיא — רֵישָׁא בִּגְדִי, וְסֵיפָא בְּטָלֶה.",
      "w0": 10,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Bekhorot 40b:9",
      "start": 1162.47,
