    },
    {
      "ref": "Bekhorot 40b:6",
      "start": 1159.61,
      "end": 1159.68,
      "he": "דְּקַטִּינָא, אֶלָּא דִּכְרִיכָא, אַף עַל גַּב דַּאֲלִימָא.",
