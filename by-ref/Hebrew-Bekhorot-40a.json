      "estimated": true
    },
    {
      "ref": "Bekhorot 40b:12",
      "start": 1165.47,
      "end": 1165.57,
      "he": "מִכְּדֵי קְרָא סְתָמָא, מָה לִי בְּגוּפוֹ וּמָה לִי בְּעֵינוֹ? אֶלָּא",
