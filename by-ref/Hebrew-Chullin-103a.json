      "he": "אֶלָּא לְרַבִּי שִׁמְעוֹן בֶּן לָקִישׁ, הֵיכִי מַשְׁכַּחַתְּ",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:6",
      "start": 2298.7,
      "end": 2298.77,
      "he": "לַהּ דִּמְחַיֵּיב? אָמַר רַב כָּהֲנָא: בִּגְרוֹמִיתָא זְעֵירְתָּא.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:7",
      "start": 2299.63,
      "end": 2299.7,
      "he": "וְרַבִּי אֶלְעָזָר אָמַר: אֲפִילּוּ חִלְּקוֹ מִבַּחוּץ נָמֵי",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:7",
      "start": 2299.7,
      "end": 2299.77,
      "he": "חַיָּיב, מְחוּסַּר קְרִיבָה לָאו כִּמְחוּסַּר מַעֲשֶׂה דָּמֵי.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 2300.63,
      "end": 2300.73,
      "he": "אָמַר רַבִּי שִׁמְעוֹן בֶּן לָקִישׁ: כְּזַיִת שֶׁאָמְרוּ – חוּץ מִשֶּׁל",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 2300.73,
      "end": 2300.82,
      "he": "בֵּין הַשִּׁינַּיִם, וְרַבִּי יוֹחָנָן אָמַר: אַף עִם בֵּין הַשִּׁינַּיִם.",
      "w0": 10,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 2301.63,
      "end": 2301.72,
      "he": "אָמַר רַב פָּפָּא: בְּשֶׁל בֵּין שִׁינַּיִם – דְּכוּלֵּי עָלְמָא",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 2301.72,
      "end": 2301.81,
      "he": "לָא פְּלִיגִי, כִּי פְּלִיגִי – בֵּין הַחֲנִיכַיִים. מָר סָבַר:",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 2301.81,
      "end": 2301.9,
      "he": "הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת, וּמָר סָבַר: אֲכִילָה בְּמֵעָיו בָּעֵינַן.",
      "w0": 18,
      "w1": 26,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 2302.63,
      "end": 2302.71,
      "he": "אָמַר רַבִּי אַסִּי אָמַר רַבִּי יוֹחָנָן: אָכַל חֲצִי",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 2302.71,
      "end": 2302.78,
      "he": "זַיִת וֶהֱקִיאוֹ, וְחָזַר וְאָכַל חֲצִי זַיִת אַחֵר",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 2302.78,
      "end": 2302.86,
      "he": "– חַיָּיב. מַאי טַעְמָא? הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת.",
      "w0": 15,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:11",
      "start": 2303.63,
      "end": 2303.72,
      "he": "בְּעָא רַבִּי אֶלְעָזָר מֵרַבִּי אַסִּי: אָכַל חֲצִי זַיִת וֶהֱקִיאוֹ",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:11",
      "start": 2303.72,
      "end": 2303.8,
      "he": "וְחָזַר וַאֲכָלוֹ, מַהוּ? מַאי קָא מִיבַּעְיָא לֵיהּ? אִי",
      "w0": 9,
      "w1": 16,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:11",
      "start": 2303.8,
      "end": 2303.89,
      "he": "הָוֵי עִיכּוּל אִי לָא הָוֵי עִיכּוּל, וְתִיבְּעֵי לֵיהּ כְּזַיִת!",
      "w0": 17,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:12",
      "start": 2304.63,
      "end": 2304.69,
      "he": "אֶלָּא, אִי בָּתַר גְּרוֹנוֹ אָזְלִינַן, אִי",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:12",
      "start": 2304.69,
      "end": 2304.76,
      "he": "בָּתַר מֵעָיו אָזְלִינַן. וְתִפְשׁוֹט לֵיהּ מִדְּרַבִּי אַסִּי!",
      "w0": 6,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 2305.63,
      "end": 2305.72,
      "he": "רַבִּי אַסִּי גְּמָרֵיהּ אִיעֲקַר לֵיהּ, וַאֲתָא רַבִּי אֶלְעָזָר לְאַדְכּוֹרֵיהּ,",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 2305.72,
      "end": 2305.81,
      "he": "וְהָכִי קָאָמַר לֵיהּ: לְמָה לִי חֲצִי זַיִת אַחֵר? לֵימָא",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 2305.81,
      "end": 2305.89,
      "he": "מָר בְּדִידֵיהּ, דְּאִיכָּא לְמִשְׁמַע מִינַּהּ תַּרְתֵּי: שָׁמְעִינַן מִינַּהּ",
      "w0": 18,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 2305.89,
      "end": 2305.98,
      "he": "דְּלָא הָוֵי עִיכּוּל, וְשָׁמְעִינַן מִינַּהּ דַּהֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת.",
      "w0": 26,
      "w1": 34,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:14",
      "start": 2306.63,
      "end": 2306.71,
      "he": "אִישְׁתִּיק וְלָא אֲמַר לֵיהּ וְלָא מִידֵּי, אֲמַר לֵיהּ:",
      "w0": 0,
