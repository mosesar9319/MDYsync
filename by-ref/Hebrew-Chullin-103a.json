      "estimated": true
    },
    {
      "ref": "Chullin 103b:14",
      "start": 2306.71,
      "end": 2306.78,
      "he": "מוֹפֵת הַדּוֹר, לָא זִימְנִין סַגִּיאִין אָמְרַתְּ קַמֵּיהּ",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:14",
      "start": 2306.78,
      "end": 2306.86,
