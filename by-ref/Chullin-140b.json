    },
    {
      "ref": "Chullin 140b:13",
      "start": 2485.24,
      "end": 2485.33,
      "he": "מִלְּשַׁלֵּחַ. אֵין שָׁם אֶלָּא אֶפְרוֹחַ אֶחָד אוֹ בֵּיצָה אַחַת",
      "w0": 16,
