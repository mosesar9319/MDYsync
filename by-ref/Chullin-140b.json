      "estimated": true
    },
    {
      "ref": "Chullin 140b:13",
      "start": 2485.33,
      "end": 2485.41,
      "he": "– חַיָּיב לְשַׁלֵּחַ, שֶׁנֶּאֱמַר ״קַן״, קֵן מִכׇּל מָקוֹם.",
      "w0": 25,
      "w1": 32,
      "estimated": true
    },
    {
      "ref": "Chullin 140b:14",
      "start": 2486.08,
      "end": 2486.16,
      "he": "הָיוּ שָׁם אֶפְרוֹחִים מַפְרִיחִים, אוֹ בֵּיצִים מוּזָרוֹת –",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 140b:14",
      "start": 2486.16,
      "end": 2486.23,
      "he": "פָּטוּר מִלְּשַׁלֵּחַ, שֶׁנֶּאֱמַר ״וְהָאֵם רֹבֶצֶת עַל הָאֶפְרֹחִים",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 140b:14",
      "start": 2486.23,
      "end": 2486.31,
      "he": "אוֹ עַל הַבֵּיצִים״, מָה אֶפְרוֹחִים בְּנֵי קַיָּימָא, אַף",
