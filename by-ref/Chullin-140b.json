    {
      "ref": "Chullin 140b:14",
      "start": 2486.38,
      "end": 2486.46,
      "he": "צְרִיכִין לְאִמָּן, אַף הָאֶפְרוֹחִין צְרִיכִין לְאִמָּן, יָצְאוּ מַפְרִיחִין.",
      "w0": 30,
