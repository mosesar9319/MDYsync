      "estimated": true
    },
    {
      "ref": "Chullin 107b:17",
      "start": 768.4,
      "end": 768.47,
      "he": "אֲבָל מַכִּירִין זֶה אֶת זֶה – אָסוּר.",
      "w0": 26,
      "w1": 32,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:18",
      "start": 851.33,
      "end": 851.4,
      "he": "תַּנְיָא נָמֵי הָכִי: רַבָּן שִׁמְעוֹן בֶּן גַּמְלִיאֵל",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:18",
      "start": 851.4,
      "end": 851.48,
      "he": "אוֹמֵר: שְׁנֵי אַכְסְנָאִים שֶׁנִּתְאָרְחוּ לְפוּנְדָּק אֶחָד, זֶה בָּא",
      "w0": 7,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:18",
      "start": 851.48,
      "end": 851.55,
      "he": "מִן הַצָּפוֹן וְזֶה בָּא מִן הַדָּרוֹם, זֶה",
      "w0": 15,
      "w1": 21,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:18",
      "start": 851.55,
      "end": 851.63,
      "he": "בָּא בַּחֲתִיכָתוֹ וְזֶה בָּא בִּגְבִינָתוֹ, אוֹכְלִין עַל שֻׁלְחָן",
      "w0": 22,
      "w1": 29,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:18",
      "start": 851.63,
      "end": 851.7,
      "he": "אֶחָד, זֶה בָּשָׂר וְזֶה גְּבִינָה, וְאֵין חוֹשְׁשִׁין.",
      "w0": 30,
      "w1": 36,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:19",
      "start": 852.33,
      "end": 852.39,
      "he": "וְלֹא אָסְרוּ אֶלָּא בִּתְפִיסָה אַחַת. תְּפִיסָה",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:19",
      "start": 852.39,
      "end": 852.46,
      "he": "אַחַת סָלְקָא דַּעְתָּךְ? אֶלָּא כְּעֵין תְּפִיסָה אַחַת.",
      "w0": 6,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:20",
      "start": 853.33,
      "end": 853.4,
      "he": "אֲמַר לֵיהּ רַב יֵימַר בַּר שֶׁלֶמְיָא לְאַבָּיֵי:",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:20",
      "start": 853.4,
      "end": 853.47,
      "he": "שְׁנֵי אַחִין, וּמַקְפִּידִין זֶה עַל זֶה, מַהוּ?",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:21",
      "start": 854.33,
      "end": 854.42,
      "he": "אֲמַר לֵיהּ: יֹאמְרוּ כׇּל הַסְּרִיקִין אֲסוּרִין, וּסְרִיקֵי בַיְיתּוֹס מוּתָּרִין?!",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:22",
      "start": 855.33,
      "end": 855.43,
      "he": "וּלְטַעְמָיךְ, הָא דְּאָמַר רַבִּי אַסִּי אָמַר רַבִּי יוֹחָנָן: מִי שֶׁאֵין",
      "w0": 0,
      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Chullin 107b:22",
      "start": 855.43,
      "end": 855.53,
