    },
    {
      "ref": "Chullin 107b:17",
      "start": 768.33,
      "end": 768.4,
      "he": "שָׁנוּ אֶלָּא שֶׁאֵין מַכִּירִין זֶה אֶת זֶה,",
      "w0": 19,
