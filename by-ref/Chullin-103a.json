      "end": 195.8,
      "he": "חַיָּיב, מְחוּסַּר קְרִיבָה לָאו כִּמְחוּסַּר מַעֲשֶׂה דָּמֵי.",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 196.33,
      "end": 196.39,
      "he": "אָמַר רַבִּי שִׁמְעוֹן בֶּן לָקִישׁ: כְּזַיִת",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 196.33,
      "end": 196.33,
      "he": "שֶׁאָמְרוּ",
      "w0": 6,
      "w1": 6
    },
    {
      "ref": "Chullin 103b:8",
      "start": 196.33,
      "end": 196.39,
      "he": "– חוּץ מִשֶּׁל בֵּין הַשִּׁינַּיִם, וְרַבִּי",
      "w0": 7,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:8",
      "start": 196.39,
      "end": 196.45,
      "he": "יוֹחָנָן אָמַר: אַף עִם בֵּין הַשִּׁינַּיִם.",
      "w0": 13,
      "w1": 18,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 1066.91,
      "end": 1067.0,
      "he": "אָמַר רַב פָּפָּא: בְּשֶׁל בֵּין שִׁינַּיִם – דְּכוּלֵּי עָלְמָא",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 1067.0,
      "end": 1067.09,
      "he": "לָא פְּלִיגִי, כִּי פְּלִיגִי – בֵּין הַחֲנִיכַיִים. מָר סָבַר:",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:9",
      "start": 1067.09,
      "end": 1067.18,
      "he": "הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת, וּמָר סָבַר: אֲכִילָה בְּמֵעָיו בָּעֵינַן.",
      "w0": 18,
      "w1": 26,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 1937.5,
      "end": 1937.58,
      "he": "אָמַר רַבִּי אַסִּי אָמַר רַבִּי יוֹחָנָן: אָכַל חֲצִי",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 1937.58,
      "end": 1937.65,
      "he": "זַיִת וֶהֱקִיאוֹ, וְחָזַר וְאָכַל חֲצִי זַיִת אַחֵר",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:10",
      "start": 1937.65,
      "end": 1937.73,
      "he": "– חַיָּיב. מַאי טַעְמָא? הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת.",
      "w0": 15,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:11",
      "start": 2808.09,
      "end": 2808.18,
      "he": "בְּעָא רַבִּי אֶלְעָזָר מֵרַבִּי אַסִּי: אָכַל חֲצִי זַיִת וֶהֱקִיאוֹ",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:11",
      "start": 2808.18,
      "end": 2808.26,
      "he": "וְחָזַר וַאֲכָלוֹ, מַהוּ? מַאי קָא מִיבַּעְיָא לֵיהּ? אִי",
      "w0": 9,
      "w1": 16,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:11",
      "start": 2808.26,
      "end": 2808.35,
      "he": "הָוֵי עִיכּוּל אִי לָא הָוֵי עִיכּוּל, וְתִיבְּעֵי לֵיהּ כְּזַיִת!",
      "w0": 17,
      "w1": 25,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:12",
      "start": 3682.0,
      "end": 3682.0,
      "he": "אֶלָּא, אִי",
      "w0": 0,
      "w1": 1
    },
    {
      "ref": "Chullin 103b:12",
      "start": 3678.67,
      "end": 3678.67,
      "he": "אִי בָּתַר",
      "w0": 1,
      "w1": 2
    },
    {
      "ref": "Chullin 103b:12",
      "start": 3678.67,
      "end": 3678.77,
      "he": "גְּרוֹנוֹ אָזְלִינַן, אִי בָּתַר מֵעָיו אָזְלִינַן. וְתִפְשׁוֹט לֵיהּ מִדְּרַבִּי אַסִּי!",
      "w0": 3,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 3698.0,
      "end": 3698.06,
      "he": "רַבִּי אַסִּי גְּמָרֵיהּ אִיעֲקַר לֵיהּ, וַאֲתָא",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 3698.06,
      "end": 3698.13,
      "he": "רַבִּי אֶלְעָזָר לְאַדְכּוֹרֵיהּ, וְהָכִי קָאָמַר לֵיהּ: לְמָה",
      "w0": 6,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 3698.0,
      "end": 3698.0,
      "he": "לִי",
      "w0": 13,
      "w1": 13
    },
    {
      "ref": "Chullin 103b:13",
      "start": 3702.0,
      "end": 3702.04,
      "he": "חֲצִי זַיִת אַחֵר? לֵימָא",
      "w0": 14,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 3702.0,
      "end": 3702.0,
      "he": "מָר",
      "w0": 18,
      "w1": 18
    },
    {
      "ref": "Chullin 103b:13",
      "start": 3702.0,
      "end": 3702.08,
      "he": "בְּדִידֵיהּ, דְּאִיכָּא לְמִשְׁמַע מִינַּהּ תַּרְתֵּי: שָׁמְעִינַן מִינַּהּ דְּלָא",
      "w0": 19,
      "w1": 26,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:13",
      "start": 3702.08,
      "end": 3702.16,
      "he": "הָוֵי עִיכּוּל, וְשָׁמְעִינַן מִינַּהּ דַּהֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת.",
      "w0": 27,
      "w1": 34,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:14",
      "start": 3703.0,
      "end": 3703.08,
      "he": "אִישְׁתִּיק וְלָא אֲמַר לֵיהּ וְלָא מִידֵּי, אֲמַר לֵיהּ:",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:14",
      "start": 3703.08,
      "end": 3703.15,
      "he": "מוֹפֵת הַדּוֹר, לָא זִימְנִין סַגִּיאִין אָמְרַתְּ קַמֵּיהּ",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:14",
      "start": 3703.15,
      "end": 3703.23,
      "he": "דְּרַבִּי יוֹחָנָן, וְאָמַר לָךְ: הֲרֵי נֶהֱנָה גְּרוֹנוֹ בִּכְזַיִת?",
      "w0": 15,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:15",
      "start": 3704.0,
      "end": 3704.04,
      "he": "הֲדַרַן עֲלָךְ גִּיד הַנָּשֶׁה.",
      "w0": 0,
      "w1": 3,
      "estimated": true
    },
    {
      "ref": "Chullin 103b:16",
      "start": 3705.0,
      "end": 3705.1,
      "he": "מַתְנִי׳ כׇּל הַבָּשָׂר אָסוּר לְבַשֵּׁל בְּחָלָב, חוּץ מִבְּשַׂר דָּגִים וַחֲגָבִים,",
      "w0": 0,
