    },
    {
      "ref": "Bekhorot 14b:15",
      "start": 2096.27,
      "end": 2096.36,
      "he": "וְהַעֲרָכָה, קׇדְשֵׁי בֶּדֶק הַבַּיִת לֹא הָיוּ בִּכְלַל הַעֲמָדָה וְהַעֲרָכָה.",
      "w0": 18,
      "w1": 26,
      "estimated": true
