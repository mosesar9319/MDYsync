    {
      "ref": "Bekhorot 14b:16",
      "start": 2097.09,
      "end": 2097.16,
      "he": "דִּתְנַן, רַבִּי שִׁמְעוֹן אוֹמֵר: קׇדְשֵׁי בֶּדֶק הַבַּיִת,",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:16",
      "start": 2097.16,
      "end": 2097.23,
