      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:16",
      "start": 2097.23,
      "end": 2097.31,
      "he": "בְּבַעַל מוּם מֵעִיקָּרוֹ שֶׁנִּפְדֶּה. מַאי טַעְמָא? דְּאָמַר קְרָא:",
      "w0": 14,
