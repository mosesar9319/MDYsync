      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:16",
      "start": 2097.31,
      "end": 2097.38,
      "he": "״אוֹתָהּ״ ״אוֹתָהּ״ — לְמַעוֹטֵי בַּעַל מוּם מֵעִיקָּרָא.",
      "w0": 22,
      "w1": 28,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:17",
      "start": 2098.09,
      "end": 2098.17,
      "he": "אֲבָל חֲכָמִים אוֹמְרִים: אִם מֵתוּ — יִקָּבֵרוּ. מַאן",
      "w0": 0,
      "w1": 7,
