      "he": "מַתְקֵיף לַהּ רַבִּי זֵירָא: אֵימָא, תְּנֵהוּ עִנְיָן",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:12",
      "start": 2093.16,
      "end": 2093.23,
      "he": "לְוַלְדוֹת קָדָשִׁים, דְּסָלְקָא דַּעְתָּךְ אָמֵינָא: הוֹאִיל וּקְדוֹשִׁין",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:12",
      "start": 2093.23,
      "end": 2093.3,
      "he": "כְּשֶׁהֵן בַּעֲלֵי מוּמִין אַגַּב אִמָּן, כְּשֶׁהֵן בַּעֲלֵי",
      "w0": 14,
      "w1": 20,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:12",
      "start": 2093.3,
      "end": 2093.37,
      "he": "מוּמִין נָמֵי קָרְבִי, קָא מַשְׁמַע לַן דְּלָא!",
      "w0": 21,
      "w1": 27,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:13",
      "start": 2094.09,
      "end": 2094.16,
      "he": "אָמַר רָבָא: כְּבָר פַּסְקַהּ תַּנָּא דְּבֵי רַבִּי",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:13",
      "start": 2094.16,
      "end": 2094.24,
      "he": "יִשְׁמָעֵאל, דְּתָנָא דְּבֵי רַבִּי יִשְׁמָעֵאל: ״רַק קָדָשֶׁיךָ אֲשֶׁר",
      "w0": 7,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:13",
      "start": 2094.24,
      "end": 2094.31,
      "he": "יִהְיוּ לְךָ וּנְדָרֶיךָ״ — ״רַק קָדָשֶׁיךָ״ אֵלּוּ",
      "w0": 15,
      "w1": 21,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:13",
      "start": 2094.31,
      "end": 2094.38,
      "he": "הַתְּמוּרוֹת, ״אֲשֶׁר יִהְיוּ לְךָ״ אֵלּוּ הַוְּולָדוֹת, ״וּנְדָרֶיךָ״",
      "w0": 22,
      "w1": 28,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:13",
      "start": 2094.38,
      "end": 2094.46,
      "he": "— הִקִּישָׁן הַכָּתוּב לְנֶדֶר, מָה נֶדֶר בַּעַל מוּם",
      "w0": 29,
      "w1": 36,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:13",
      "start": 2094.46,
      "end": 2094.53,
      "he": "לֹא, אַף הָנֵי נָמֵי בַּעַל מוּם לֹא.",
      "w0": 37,
      "w1": 43,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:14",
      "start": 2095.09,
      "end": 2095.17,
      "he": "וְאֵין עוֹשִׂין תְּמוּרָה, מַאי טַעְמָא? דְּאָמַר קְרָא: ״לֹא",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:14",
      "start": 2095.17,
      "end": 2095.24,
      "he": "יַחֲלִיפֶנּוּ וְלֹא יָמִיר וְגוֹ׳״. הַשְׁתָּא רַע בְּטוֹב",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:14",
      "start": 2095.24,
      "end": 2095.31,
      "he": "אָמְרַתְּ לֹא, טוֹב בְּרָע מִיבַּעְיָא? אֶלָּא טוֹב",
      "w0": 15,
      "w1": 21,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:14",
      "start": 2095.31,
      "end": 2095.39,
      "he": "מֵעִיקָּרוֹ עוֹשֶׂה תְּמוּרָה, רַע מֵעִיקָּרוֹ אֵין עוֹשֶׂה תְּמוּרָה.",
      "w0": 22,
      "w1": 29,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:15",
      "start": 2096.09,
      "end": 2096.18,
      "he": "אִם מֵתוּ יִפָּדוּ. אָמַר רַב יְהוּדָה אָמַר רַב: זוֹ",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Bekhorot 14b:15",
      "start": 2096.18,
      "end": 2096.27,
      "he": "דִּבְרֵי רַבִּי שִׁמְעוֹן, דְּאָמַר: קׇדְשֵׁי מִזְבֵּחַ הָיוּ בִּכְלַל הַעֲמָדָה",
      "w0": 9,
      "w1": 17,
