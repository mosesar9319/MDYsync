      "he": "לָא קָאָמַר אֶלָּא בְּאוֹמֵר ״הֲרֵי זוֹ״,",
      "w0": 30,
      "w1": 35,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):1",
      "start": 1808.33,
      "end": 1808.4,
      "he": "מַתְנִי׳ הַכֹּל שׁוֹחֲטִין וּשְׁחִיטָתָן כְּשֵׁרָה, חוּץ מֵחֵרֵשׁ",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):1",
      "start": 1808.4,
      "end": 1808.47,
      "he": "שׁוֹטֶה וְקָטָן, שֶׁמָּא יְקַלְקְלוּ אֶת שְׁחִיטָתָן. וְכוּלָּן",
      "w0": 7,
      "w1": 13,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):1",
      "start": 1808.47,
      "end": 1808.54,
      "he": "שֶׁשָּׁחֲטוּ וַאֲחֵרִים רוֹאִין אוֹתָן – שְׁחִיטָתָן כְּשֵׁרָה.",
      "w0": 14,
      "w1": 20,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):2",
      "start": 1814.33,
      "end": 1814.42,
      "he": "גְּמָ׳ ״הַכֹּל שׁוֹחֲטִין״ – לְכַתְּחִלָּה, ״וּשְׁחִיטָתָן כְּשֵׁרָה״ – דִּיעֲבַד!",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):3",
      "start": 1820.33,
      "end": 1823.33,
      "he": "אֲמַר לֵיהּ רַב",
      "w0": 0,
      "w1": 2
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):3",
      "start": 1864.67,
      "end": 1866.0,
      "he": "אֲמַר לֵיהּ",
      "w0": 0,
      "w1": 1
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):3",
      "start": 1883.0,
      "end": 1883.67,
      "he": "אֲמַר לֵיהּ",
      "w0": 0,
      "w1": 1
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):3",
      "start": 1878.67,
      "end": 1880.67,
      "he": "לֵיהּ רַב אַחָא בְּרֵיהּ",
      "w0": 1,
      "w1": 4
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):3",
      "start": 1880.67,
      "end": 1880.75,
      "he": "דְּרָבָא לְרַב אָשֵׁי: וְכֹל ״הַכֹּל״ לְכַתְּחִלָּה הוּא? אֶלָּא",
      "w0": 5,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):3",
      "start": 1880.75,
      "end": 1880.83,
      "he": "מֵעַתָּה: הַכֹּל מְמִירִין, אֶחָד הָאֲנָשִׁים וְאֶחָד הַנָּשִׁים –",
      "w0": 13,
      "w1": 20,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):3",
      "start": 1880.83,
      "end": 1880.91,
      "he": "הָכִי נָמֵי דִּלְכַתְּחִלָּה הוּא? וְהָא כְּתִיב: ״לֹא יַחֲלִיפֶנּוּ",
      "w0": 21,
      "w1": 28,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):3",
      "start": 1880.91,
      "end": 1880.99,
      "he": "וְלֹא יָמִיר אֹתוֹ טוֹב בְּרָע אוֹ רַע בְּטוֹב״!",
      "w0": 29,
      "w1": 36,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):4",
      "start": 1884.67,
      "end": 1884.75,
      "he": "הָתָם, כִּדְקָתָנֵי טַעְמָא: לֹא שֶׁהָאָדָם רַשַּׁאי לְהָמִיר, אֶלָּא",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):4",
      "start": 1884.75,
      "end": 1884.82,
      "he": "שֶׁאִם הֵמִיר – מוּמָר, וְסוֹפֵג אֶת הָאַרְבָּעִים.",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):5",
      "start": 1885.67,
      "end": 1885.76,
      "he": "אֶלָּא הַכֹּל מַעֲרִיכִין וְנֶעֱרָכִין, נוֹדְרִין וְנִידָּרִין, הָכִי נָמֵי דִּלְכַתְּחִלָּה?",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):5",
      "start": 1885.76,
      "end": 1885.85,
      "he": "וְהָא כְּתִיב: ״וְכִי תֶחְדַּל לִנְדֹּר לֹא יִהְיֶה בְךָ חֵטְא״!",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):6",
      "start": 1886.67,
      "end": 1886.76,
      "he": "וּכְתִיב: ״טוֹב אֲשֶׁר לֹא תִדֹּר מִשֶּׁתִּדּוֹר וְלֹא תְשַׁלֵּם״, וְתַנְיָא:",
      "w0": 0,
      "w1": 8,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):6",
      "start": 1886.76,
      "end": 1886.85,
      "he": "טוֹב מִזֶּה וּמִזֶּה שֶׁאֵינוֹ נוֹדֵר כׇּל עִיקָּר, דִּבְרֵי רַבִּי",
      "w0": 9,
      "w1": 17,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):6",
      "start": 1886.85,
      "end": 1886.94,
      "he": "מֵאִיר. רַבִּי יְהוּדָה אוֹמֵר: טוֹב מִזֶּה וּמִזֶּה נוֹדֵר וּמְשַׁלֵּם.",
      "w0": 18,
      "w1": 26,
      "estimated": true
    },
    {
      "ref": "Chullin 99b (Chazarah Daf):6",
