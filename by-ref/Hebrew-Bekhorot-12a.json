      "he": "הַבֵּן, וּבִנְזִירוּת, וּבְפֶטֶר חֲמוֹר — פָּחוֹת מִשְּׁלֹשִׁים.",
      "w0": 8,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Bekhorot 12b:25",
      "start": 512.5,
      "end": 512.53,
      "he": "וּמוֹסִיפִין עַד עוֹלָם!",
      "w0": 0,
      "w1": 2,
      "estimated": true
    },
    {
      "ref": "Bekhorot 12b:26",
      "start": 513.5,
      "end": 513.58,
      "he": "אָמַר רַב נַחְמָן: לוֹמַר שֶׁאִם פְּדָאוֹ — פָּדוּי,",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 12b:26",
      "start": 513.58,
      "end": 513.67,
      "he": "מִכְּלָל דִּבְנוֹ אִם פְּדָאוֹ אֵינוֹ פָּדוּי? וְהָאִיתְּמַר: הַפּוֹדֶה אֶת",
      "w0": 8,
      "w1": 16,
      "estimated": true
    },
    {
      "ref": "Bekhorot 12b:26",
      "start": 513.67,
      "end": 513.75,
      "he": "בְּנוֹ בְּתוֹךְ שְׁלֹשִׁים יוֹם, רַב אָמַר: בְּנוֹ פָּדוּי!",
      "w0": 17,
      "w1": 24,
      "estimated": true
    },
    {
      "ref": "Bekhorot 12b:27",
      "start": 514.5,
      "end": 514.56,
      "he": "לָאו אִיתְּמַר עֲלַהּ, אָמַר רָבָא: דְּכוּלֵּי",
      "w0": 0,
      "w1": 5,
      "estimated": true
    },
    {
      "ref": "Bekhorot 12b:27",
      "start": 514.56,
      "end": 514.62,
      "he": "עָלְמָא ״מֵעַכְשָׁיו״ — אֵין בְּנוֹ פָּדוּי.",
      "w0": 6,
      "w1": 11,
      "estimated": true
    }
