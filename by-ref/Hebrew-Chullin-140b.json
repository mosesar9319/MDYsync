      "w1": 9,
      "estimated": true
    },
    {
      "ref": "Chullin 140b:15",
      "start": 882.1,
      "end": 882.2,
      "he": "נוֹגְעוֹת בַּקֵּן? תַּלְמוּד לוֹמַר ״רוֹבֶצֶת״. מַאי תַּלְמוּדָא? מִדְּלָא כְּתִיב ״יוֹשֶׁבֶת״.",
      "w0": 10,
      "w1": 19,
      "estimated": true
    },
    {
      "ref": "Chullin 140b:16",
      "start": 883.0,
      "end": 883.08,
      "he": "אָמַר רַב יְהוּדָה אָמַר רַב: הָיְתָה יוֹשֶׁבֶת בֵּין",
