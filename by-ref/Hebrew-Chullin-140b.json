      "estimated": true
    },
    {
      "ref": "Chullin 140b:14",
      "start": 881.3,
      "end": 881.38,
      "he": "צְרִיכִין לְאִמָּן, אַף הָאֶפְרוֹחִין צְרִיכִין לְאִמָּן, יָצְאוּ מַפְרִיחִין.",
      "w0": 30,
      "w1": 37,
      "estimated": true
    },
    {
      "ref": "Chullin 140b:15",
      "start": 882.0,
      "end": 882.1,
      "he": "גְּמָ׳ תָּנוּ רַבָּנַן: ״רוֹבֶצֶת״ – וְלֹא מְעוֹפֶפֶת. יָכוֹל אֲפִילּוּ כְּנָפֶיהָ",
