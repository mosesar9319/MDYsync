      "ref": "Bekhorot 61a:8",
      "start": 2926.32,
      "end": 2926.39,
      "he": "קַמֵּיהּ דְּרַבִּי יוֹחָנָן: בְּמַעֲשֵׂר בִּזְמַן הַזֶּה עָסְקִינַן,",
      "w0": 6,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:8",
      "start": 2926.26,
      "end": 2926.26,
      "he": "וּמִשּׁוּם",
      "w0": 13,
      "w1": 13
    },
    {
      "ref": "Bekhorot 61a:8",
      "start": 2926.26,
      "end": 2926.27,
      "he": "תַּקָּלָה.",
      "w0": 14,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:9",
      "start": 2858.69,
      "end": 2858.77,
      "he": "אִי הָכִי, מַאי אִירְיָא תְּרֵי? אֲפִילּוּ חַד נָמֵי!",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:9",
      "start": 2858.77,
      "end": 2858.85,
      "he": "לָא מִיבַּעְיָא קָאָמַר: לָא מִיבַּעְיָא חַד דְּלֵית לֵיהּ",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:9",
      "start": 2858.85,
      "end": 2858.93,
      "he": "פְּסֵידָא, אֲבָל תְּרֵי, כֵּיוָן דִּנְפִישִׁי פְּסֵידָא — לִישַׁהִינְהוּ",
      "w0": 16,
      "w1": 23,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:9",
      "start": 2858.93,
      "end": 2859.01,
      "he": "עַד דְּנִיפּוֹל בְּהוּ מוּמָא וְלֵיכְלִינְהוּ, קָא מַשְׁמַע לַן.",
      "w0": 24,
      "w1": 31,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:10",
      "start": 2863.86,
      "end": 2863.94,
      "he": "אִיתְּמַר: הָאוֹמֵר לִשְׁלוּחוֹ ״צֵא וְעַשֵּׂר עָלַי״, רַב פַּפִּי",
      "w0": 0,
      "w1": 7,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:10",
      "start": 2863.94,
      "end": 2864.02,
      "he": "מִשְּׁמֵיהּ דְּרָבָא אָמַר: קָרָא לַתְּשִׁיעִי ״עֲשִׂירִי״ — קָדוֹשׁ,",
      "w0": 8,
      "w1": 15,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:10",
      "start": 2864.02,
      "end": 2864.09,
      "he": "וְלָאַחַד עָשָׂר ״עֲשִׂירִי״ — אֵינוֹ קָדוֹשׁ. וְרַב",
      "w0": 16,
      "w1": 22,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:10",
      "start": 2864.09,
      "end": 2864.17,
      "he": "פָּפָּא אָמַר: אֲפִילּוּ קָרָא לַתְּשִׁיעִי ״עֲשִׂירִי״ — אֵינוֹ",
      "w0": 23,
      "w1": 30,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:10",
      "start": 2863.86,
      "end": 2879.88,
      "he": "",
      "w0": 31,
      "w1": 28
    },
    {
      "ref": "Bekhorot 61a:10",
      "start": 2791.12,
      "end": 2791.2,
      "he": "— אֵינוֹ קָדוֹשׁ, דְּאָמַר לֵיהּ: לְתַקּוֹנֵי שַׁדַּרְתָּיךָ וְלָא",
      "w0": 29,
      "w1": 36,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:10",
      "start": 2791.12,
      "end": 2791.12,
      "he": "לְעַוּוֹתֵי.",
      "w0": 37,
      "w1": 37
    },
    {
      "ref": "Bekhorot 61a:11",
      "start": 2790.12,
      "end": 2791.12,
      "he": "וּמַאי שְׁנָא",
      "w0": 0,
      "w1": 1
    },
    {
      "ref": "Bekhorot 61a:11",
      "start": 2791.12,
      "end": 2791.23,
      "he": "מֵהָא דִּתְנַן: הָאוֹמֵר לִשְׁלוּחוֹ ״צֵא וּתְרוֹם״ — תּוֹרֵם כְּדַעַת בַּעַל הַבַּיִת.",
      "w0": 2,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:12",
      "start": 1970.97,
      "end": 1971.01,
      "he": "אִם אֵינוֹ יוֹדֵעַ דַּעְתּוֹ",
      "w0": 0,
      "w1": 3,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:12",
      "start": 1970.97,
      "end": 1970.97,
      "he": "שֶׁל",
      "w0": 4,
      "w1": 4
    },
    {
      "ref": "Bekhorot 61a:12",
      "start": 1970.97,
      "end": 1971.05,
      "he": "בַּעַל הַבַּיִת — תּוֹרֵם בְּבֵינוֹנִית, אֶחָד מֵחֲמִשִּׁים. פִּיחֵת",
      "w0": 5,
      "w1": 12,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:12",
      "start": 1971.05,
      "end": 1971.12,
      "he": "עֲשָׂרָה אוֹ הוֹסִיף עֲשָׂרָה — תְּרוּמָתוֹ תְּרוּמָה?",
      "w0": 13,
      "w1": 19,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:13",
      "start": 1971.97,
      "end": 1972.04,
      "he": "אָמְרִי: הָתָם, כֵּיוָן דְּאִיכָּא דְּתָרֵים בְּעַיִן יָפָה,",
      "w0": 0,
      "w1": 6,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:13",
      "start": 1972.04,
      "end": 1972.12,
      "he": "וְאִיכָּא דְּתָרֵים בְּעַיִן רָעָה, אָמַר: לְהָכִי אֲמַדְתִּיךְ. הָכָא",
      "w0": 7,
      "w1": 14,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:13",
      "start": 1972.12,
      "end": 1972.19,
      "he": "טָעוּתָא הִיא, אָמַר: לָא אִיבְּעִי לָךְ לְמִיטְעֵי.",
      "w0": 15,
      "w1": 21,
      "estimated": true
    },
    {
      "ref": "Bekhorot 61a:14",
      "start": 1972.97,
      "end": 1973.05,
      "he": "הֲדַרַן עֲלָךְ מַעְשַׂר בְּהֵמָה, וּסְלִיקָא לַהּ מַסֶּכֶת בְּכוֹרוֹת.",
      "w0": 0,
      "w1": 7,
      "estimated": true
    }
  ],
